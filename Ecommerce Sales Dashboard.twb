      <column caption='YOY sales margin' datatype='string' name='[Calculation_0370009455570944]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_0691887616184325]&gt;0 THEN&apos;▲&apos; ELSEIF [Calculation_0691887616184325]&lt;0 THEN&apos;▼&apos; END' />
      </column>
      <column caption='YTD Sales' datatype='real' name='[Calculation_0370009469489165]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF YEAR([Order Date])={MAX(YEAR([Order Date]))} THEN [Sales] END' />
      </column>
      <column caption='%Difference' datatype='real' name='[Calculation_0370009487736847]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([Calculation_0370009469489165])-SUM([YTD Sales (copy)_0370009487446030]))/SUM([YTD Sales (copy)_0370009487446030])' />
      </column>
      <column caption='Sales Margin' datatype='string' name='[Calculation_0370009488769040]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF SUM([Calculation_0370009469489165])-SUM([YTD Sales (copy)_0370009487446030])&lt;0 THEN &apos;Less than PY&apos;&#13;&#10;ELSEIF SUM([Calculation_0370009469489165])-SUM([YTD Sales (copy)_0370009487446030])&gt;0 THEN &apos;Greater than PY&apos;&#13;&#10;ELSEIF  ISNULL(SUM([YTD Sales (copy)_0370009487446030])) THEN &apos;No sales in PY&apos;&#13;&#10;END' />
      </column>
      <column caption='Positive % Difference' datatype='string' name='[Calculation_0370009491251217]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_0370009487736847]&gt;0 THEN &apos;▲&apos; END' />
      </column>
      <column caption='No Sales' datatype='string' name='[Calculation_0370009492140051]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_0370009488769040]=&apos;No sales PY&apos; THEN &apos;No sales in PY&apos; END' />
      </column>
      <column caption='YTD Sales LOD' datatype='real' name='[Calculation_0691887611752448]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED  : SUM(IF YEAR([Order Date])= {MAX(YEAR([Order Date]))} THEN [Sales] END)}' />
